# Flutter web has no runtime .env loading — these are NOT read from a file automatically.
# They must be passed as --dart-define flags at build/run time (see README), or as Docker
# build ARGs when deploying via frontend/Dockerfile. This file exists only to document what's
# required and its expected shape.

# Your deployed backend's public URL, with the API prefix.
API_BASE_URL=http://localhost:8000/api/v1

# Supabase project URL + anon (public) key — Project Settings -> API in the Supabase dashboard.
# Same project the backend's SUPABASE_URL/SUPABASE_JWT_SECRET point at.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
