ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["*"]
# In production, restrict to the deployed frontend's exact origin instead of "*", e.g.:
# CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# Optional overrides — every setting below has a working default (see app/core/config.py);
# only uncomment if you need to change it.
# APP_NAME=Aari AI Designer
# API_V1_PREFIX=/api/v1
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for local dev, PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./aari_designer.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aari_designer
SQL_ECHO=false

SECRET_KEY=change-this-in-production

# Supabase Authentication — Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini — get a key at https://aistudio.google.com (billing required beyond the free tier's
# daily quota). Vision analysis only: garment/colour analysis + QA-scoring generated
# visualizations. Never generates images.
GEMINI_API_KEY=your-gemini-key
GEMINI_TEXT_MODEL=gemini-flash-latest

# OpenAI — get a key at https://platform.openai.com/api-keys (billing required)
OPENAI_API_KEY=your-openai-key

# Older text-to-image /generation/preview flow, kept as a fallback for hex-colour-only blouses.
# OPENAI_IMAGE_QUALITY: low (cheapest, ~$0.011/image) | medium (~$0.04) | high (~$0.167)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low

# Main visualization pipeline (images.edit()) — composes the final boutique product photograph
# from the uploaded blouse, saree and embroidery reference photos.
OPENAI_EDIT_MODEL=gpt-image-1
OPENAI_EDIT_QUALITY=high
# 0-100 QA threshold (Gemini-scored) below which a single retry attempt fires — see
# app/services/visualization_pipeline.py.
VISUALIZATION_QA_ACCEPT_THRESHOLD=70.0

# "View on Mannequin" — separate, optional post-processing stage. Independently tunable quality.
OPENAI_MANNEQUIN_QUALITY=high
